+// PSC patch: a blur under a masked *parent* renders unblurred on iOS, but a
+// mask set on the UIVisualEffectView's own maskView is supported. The mask
+// keeps the full blur up to `progressiveStart` and then fades it out with an
+// ease-in-out curve towards the opposite edge.
+- (void)updateProgressiveMask
+{
+  NSString *direction = self.progressiveDirection;
+  if (direction == nil || [direction isEqualToString:@"none"]) {
+    if (self.blurEffectView.maskView != nil) {
+      self.blurEffectView.maskView = nil;
+    }
+    return;
+  }
+
+  CGRect bounds = self.bounds;
+  if (CGRectIsEmpty(bounds)) {
+    return;
+  }
+
+  UIView *mask = self.blurEffectView.maskView;
+  CAGradientLayer *gradient = nil;
+  if (mask != nil && [mask.layer.sublayers.firstObject isKindOfClass:[CAGradientLayer class]]) {
+    gradient = (CAGradientLayer *)mask.layer.sublayers.firstObject;
+  } else {
+    mask = [[UIView alloc] initWithFrame:bounds];
+    mask.backgroundColor = [UIColor clearColor];
+    gradient = [CAGradientLayer layer];
+    [mask.layer addSublayer:gradient];
+  }
+
+  CGFloat start = (CGFloat)[self.progressiveStart doubleValue];
+  if (start < 0) {
+    // negative = fade length in points (measured from the far edge), so the
+    // mask follows the view's height natively while it is being resized
