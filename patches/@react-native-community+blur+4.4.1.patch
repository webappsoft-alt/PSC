+    start = length > 0 ? 1 - MIN(-start, length) / length : 0;
+  }
+  start = MIN(MAX(start, 0), 1);
+
+  NSMutableArray *colors = [NSMutableArray array];
+  NSMutableArray *locations = [NSMutableArray array];
+  [colors addObject:(id)[UIColor colorWithWhite:0 alpha:1].CGColor];
+  [locations addObject:@0];
+  const int steps = 12;
+  for (int i = 0; i <= steps; i++) {
+    CGFloat u = (CGFloat)i / steps;
+    CGFloat eased = u < 0.5 ? 4 * u * u * u : 1 - pow(-2 * u + 2, 3) / 2;
+    [colors addObject:(id)[UIColor colorWithWhite:0 alpha:(1 - eased)].CGColor];
+    [locations addObject:@(start + (1 - start) * u)];
+  }
+
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  mask.frame = bounds;
+  gradient.frame = mask.bounds;
+  gradient.colors = colors;
+  gradient.locations = locations;
